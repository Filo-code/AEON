# AEON by Rekt - systemd service template for bot
# This file is a template; install.sh/install_vps.sh will copy and replace variables.
[Unit]
Description=AEON by Rekt Paper Trading Bot (simulation only)
After=network-online.target
Wants=network-online.target
Documentation=man:paper-bot(8) https://github.com/aeon-by-rekt/docs
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=notify
NotifyAccess=main
User=${SERVICE_USER}
Group=${SERVICE_GROUP}
WorkingDirectory=${INSTALL_DIR}
EnvironmentFile=${INSTALL_DIR}/.env
Environment=PYTHONUNBUFFERED=1
Environment=DATA_DIR=${DATA_DIR}
Environment=LOG_STDOUT=0
ExecStart=${INSTALL_DIR}/.venv/bin/python bot/paper_bot.py
WatchdogSec=300
TimeoutStartSec=180
TimeoutStopSec=45
Restart=always
RestartPreventExitStatus=78,79
RestartSec=10
KillSignal=SIGTERM
KillMode=process
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=${DATA_DIR}
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Chromium headless for hourly dashboard screenshot
Environment=XDG_CONFIG_HOME=/tmp XDG_CACHE_HOME=/tmp XDG_STATE_HOME=/tmp
Environment=SCREENSHOT_NO_SANDBOX=1
MemoryMax=1G
MemoryHigh=800M
CPUQuota=80%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target