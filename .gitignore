# ==============================================================================
# AEON by Rekt — .gitignore
# ==============================================================================

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.mypy_cache/
.tox/
.hypothesis/

# Test & coverage artifacts
.pytest_cache/
.pytest_tmp/
.tmp_pytest/
.coverage
.coverage.*
htmlcov/
*.log
telegram_outbox.log
bot.log

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment files & Secrets (never commit credentials)
.env
.env.*
.env.local
!.env.example

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.claude/
.impeccable/

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini

# Packaging & Build artifacts
dist/
build/
*.egg-info/
*.egg
*.tar.gz
*.zip

# Runtime state & data (preserve data directory structure, exclude live state)
data/*.json
data/*.json.bak
data/*.bad
data/*.tmp
data/backups/
!data/.gitkeep
!data/README.md

# Staging & manual backup folders
staging_backup_pre_patch/
backups-manuali/
data.before-restore-*/
test-extract/

# Temporary patch & migration artifacts
apply_aeon_patches.py
update_aeon_tests.py
scripts/apply_final_fixes.py
scripts/patch_dashboard_js.py
scripts/patch_dashboard_js_v2.py
scripts/tools_audit.py

.venv-test/

# AEON runtime data
data/*
!data/.gitkeep
!data/README.md

# Temporary code backups
*.bak
*.bak_*
*.pre_*
*.backup
*.backup_*

*.bak*

bot/config.yaml
